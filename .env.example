# Copy to .env and fill in. The LLM client reads the OPENAI_* block.
OPENAI_BASE_URL=https://xeduapi.com
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL_NAME=gpt-5.4
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_DELAY=2
OPENAI_MAX_CONCURRENT=10
# Optional: omit to let the model use its default sampling.
# OPENAI_TEMPERATURE=0.0

# Local small LLM (optional; not used by the RoBERTa/GPT-5.4 diagnostic path).
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507

PHEME_RAW_DIR=./data/pheme_raw
PROJECT_ROOT=./
